<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration: the GitHub Actions artifact is a zip containing
     VNCFavourites.exe, which must carry the expected product name before it is signed. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <pe-file path="VNCFavourites.exe" product-name="VNC Favourites">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
